{
  "rules": {
    "users": { "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid",
      "totalSavings": { ".write": false },
      "verifiedDepositCount": { ".write": false },
      "depositHistory": { "$event": { ".validate": "newData.hasChildren(['eventId','verificationStatus','timestamp']) && newData.child('eventId').val() === $event" } }
    }}
  }
}
